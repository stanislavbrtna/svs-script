function main {
  #This will test v. 1.10 function arguments
  FAIL = 0;
  
  x = test1(1, 2, 3, 4);
  
  if (x[0] != 1 or x[1] != 2 or x[2] != 3 or x[3] != 4 ) {
    FAIL = 1;
    print("== FAIL 1");
  }
  
  x = test2(4, 3, 2, 1);
  
  if (x[0] != 4 or x[1] != 3 or x[2] != 2 or x[3] != 1) {
    FAIL = 1;
    print("== FAIL 2");
  }
  
  f1();
  
  if (f2(8) != 10) {
    FAIL = 1;
    print("== FAIL 3");
  }
  
  b = 4;
  
  f3();
  
  if (b != 2) {
    FAIL = 1;
    print("== FAIL 4");
  }
  
  print("Function arguments Test result: ", "");
  
  if (FAIL == 0) {
    print("PASSED");
  } else {
    print("FAIL");
  }
  
  return FAIL;
}

function test1(
  a,
  b,
  c,
  d,
) {
  local array f = [a, b, c, d];
  
  return f;
}

function test2(
  a,
  b,
  c,
  d) {
  local array f = [a, b, c, d];
  
  return f;
}

function f1 {}
function f2 (a) return a + 2;
function f3 b = 2;
